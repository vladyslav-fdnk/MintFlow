# The server's /srv/mintflow/healthchecks.env (mode 600): one Healthchecks.io ping URL per job.
# Kept apart from .env so the app containers never receive them. Each check's schedule matches
# the crontab; a missed or failed run alerts by email.
HEALTHCHECK_BACKUP=https://hc-ping.com/replace-with-the-backup-check-uuid
HEALTHCHECK_AUTH_CLEANUP=https://hc-ping.com/replace-with-the-authentication-cleanup-check-uuid
HEALTHCHECK_TELEGRAM_CLEANUP=https://hc-ping.com/replace-with-the-telegram-cleanup-check-uuid
HEALTHCHECK_EXCHANGE_RATES=https://hc-ping.com/replace-with-the-exchange-rates-check-uuid
HEALTHCHECK_DISK=https://hc-ping.com/replace-with-the-disk-check-uuid
