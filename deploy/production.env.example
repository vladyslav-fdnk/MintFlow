# The server's /srv/mintflow/.env (mode 600, never committed). Generate every secret once with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Every value below is an example.

# Compose
MINTFLOW_IMAGE_TAG=0000000000000000000000000000000000000000
MINTFLOW_DOMAIN=mintflow.example
ACME_EMAIL=owner@mintflow.example
POSTGRES_DB=mintflow
POSTGRES_USER=mintflow
POSTGRES_PASSWORD=replace-with-a-random-secret

# Application (MINTFLOW_ENVIRONMENT, MINTFLOW_DATABASE_URL, and MINTFLOW_TRUSTED_PROXIES are set
# by compose.production.yaml)
MINTFLOW_LOG_LEVEL=INFO
MINTFLOW_ENABLE_API_DOCS=false
MINTFLOW_AUTHENTICATION_RATE_LIMIT_KEY=replace-with-a-random-secret
MINTFLOW_AUTHENTICATION_CSRF_SIGNING_KEY=replace-with-a-random-secret
MINTFLOW_AUTHENTICATION_WEB_ORIGIN=https://mintflow.example
MINTFLOW_AUTHENTICATION_RETURN_TARGETS=["dashboard"]

# Email through Resend (O3)
MINTFLOW_EMAIL_BACKEND=smtp
MINTFLOW_SMTP_HOST=smtp.resend.com
MINTFLOW_SMTP_PORT=465
MINTFLOW_SMTP_TLS=implicit
MINTFLOW_SMTP_USERNAME=resend
MINTFLOW_SMTP_PASSWORD=replace-with-the-resend-api-key
MINTFLOW_SMTP_FROM_EMAIL=no-reply@mintflow.example

# Telegram (all three)
MINTFLOW_TELEGRAM_BOT_TOKEN=replace-with-the-botfather-token
MINTFLOW_TELEGRAM_BOT_USERNAME=mintflow_bot
MINTFLOW_TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret

# Receipt recognition: leave unset for the manual fallback until RCPT-07.
# MINTFLOW_RECEIPT_RECOGNIZER=azure
# MINTFLOW_AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# MINTFLOW_AZURE_DOCUMENT_INTELLIGENCE_KEY=
