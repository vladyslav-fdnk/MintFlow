# The server's /srv/mintflow/backup.env (mode 600): where encrypted backups go (O7).
# Only the age PUBLIC key belongs here. Create the pair on your own computer with `age-keygen`,
# keep the private key offline (it is needed only to restore), and paste the public key below.
BACKUP_AGE_RECIPIENT=age1replacewiththepublickeyfromagekeygenxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Hetzner Object Storage, in the server's region, with a key limited to this bucket.
BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_S3_BUCKET=mintflow-backups
BACKUP_S3_PREFIX=nightly/
AWS_ACCESS_KEY_ID=replace-with-the-access-key
AWS_SECRET_ACCESS_KEY=replace-with-the-secret-key
AWS_DEFAULT_REGION=fsn1

# Once per bucket, so backups expire after 30 days (the retention statement in
# docs/authentication_persistence_design.md; docs/operations_design.md, O7):
#   docker compose -f compose.production.yaml --profile tools run --rm -T -v "$PWD/backup-lifecycle.json:/work/lifecycle.json:ro" \
#     backup aws s3api put-bucket-lifecycle-configuration --bucket mintflow-backups \
#     --endpoint-url https://fsn1.your-objectstorage.com --lifecycle-configuration file:///work/lifecycle.json
