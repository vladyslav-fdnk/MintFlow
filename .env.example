MINTFLOW_ENVIRONMENT=development
MINTFLOW_LOG_LEVEL=INFO
MINTFLOW_ENABLE_API_DOCS=true
MINTFLOW_DATABASE_URL=postgresql://mintflow:change-me@localhost:55432/mintflow
MINTFLOW_DOCKER_DATABASE_URL=postgresql://mintflow:change-me@postgres:5432/mintflow
MINTFLOW_AUTHENTICATION_RATE_LIMIT_KEY=replace-with-a-random-secret
MINTFLOW_AUTHENTICATION_CSRF_SIGNING_KEY=replace-with-a-random-secret
MINTFLOW_AUTHENTICATION_WEB_ORIGIN=http://localhost:8000
MINTFLOW_AUTHENTICATION_RETURN_TARGETS=["dashboard"]
MINTFLOW_EMAIL_BACKEND=mailpit
MINTFLOW_MAILPIT_SMTP_HOST=localhost
MINTFLOW_MAILPIT_SMTP_PORT=1025
MINTFLOW_MAILPIT_SMTP_TIMEOUT_SECONDS=5
MINTFLOW_MAILPIT_FROM_EMAIL=no-reply@mintflow.dev

# Deployed email (docs/operations_design.md, O3): set MINTFLOW_EMAIL_BACKEND=smtp instead of
# mailpit. For Resend: host smtp.resend.com, port 465 with implicit TLS (or 587 with starttls),
# username "resend", and an API key as the password. The sender's domain needs SPF, DKIM, DMARC.
# MINTFLOW_SMTP_HOST=smtp.resend.com
# MINTFLOW_SMTP_PORT=465
# MINTFLOW_SMTP_TLS=implicit
# MINTFLOW_SMTP_USERNAME=resend
# MINTFLOW_SMTP_PASSWORD=
# MINTFLOW_SMTP_FROM_EMAIL=no-reply@mintflow.example
# MINTFLOW_SMTP_TIMEOUT_SECONDS=10

# Reverse proxies whose X-Forwarded-For is believed (O2), as a JSON list of addresses or
# networks, for example the Compose network Caddy runs on. Leave unset when nothing sits in front
# of the app: forwarding headers are then ignored.
# MINTFLOW_TRUSTED_PROXIES=["172.30.0.0/24"]

# In production (MINTFLOW_ENVIRONMENT=production) the Web app refuses to start unless API docs
# are off, the Web origin is https://, the email backend is smtp, Telegram is configured, and the
# receipt recognizer is not fake (O4).
POSTGRES_DB=mintflow
POSTGRES_USER=mintflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Telegram Client (optional). All three together enable the bot; create it with @BotFather.
# MINTFLOW_TELEGRAM_BOT_TOKEN=
# MINTFLOW_TELEGRAM_BOT_USERNAME=
# MINTFLOW_TELEGRAM_WEBHOOK_SECRET=

# Receipt recognition. "azure" uses Azure AI Document Intelligence (prebuilt receipt model; the
# free F0 tier allows 500 pages a month); receipts are sent to Microsoft for analysis. "fake"
# reads nothing (every receipt falls back to manual entry) and is allowed only in development
# and test.
# MINTFLOW_RECEIPT_RECOGNIZER=azure
# MINTFLOW_AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# MINTFLOW_AZURE_DOCUMENT_INTELLIGENCE_KEY=
