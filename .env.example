MINTFLOW_ENVIRONMENT=development
MINTFLOW_LOG_LEVEL=INFO
MINTFLOW_ENABLE_API_DOCS=true
MINTFLOW_DATABASE_URL=postgresql://mintflow:change-me@localhost:55432/mintflow
MINTFLOW_DOCKER_DATABASE_URL=postgresql://mintflow:change-me@postgres:5432/mintflow
MINTFLOW_AUTHENTICATION_RATE_LIMIT_KEY=replace-with-a-random-secret
MINTFLOW_AUTHENTICATION_CSRF_SIGNING_KEY=replace-with-a-random-secret
MINTFLOW_AUTHENTICATION_WEB_ORIGIN=http://localhost:8000
MINTFLOW_AUTHENTICATION_RETURN_TARGETS=["dashboard"]
MINTFLOW_EMAIL_BACKEND=mailpit
MINTFLOW_MAILPIT_SMTP_HOST=localhost
MINTFLOW_MAILPIT_SMTP_PORT=1025
MINTFLOW_MAILPIT_SMTP_TIMEOUT_SECONDS=5
MINTFLOW_MAILPIT_FROM_EMAIL=no-reply@mintflow.dev
POSTGRES_DB=mintflow
POSTGRES_USER=mintflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Telegram Client (optional). All three together enable the bot; create it with @BotFather.
# MINTFLOW_TELEGRAM_BOT_TOKEN=
# MINTFLOW_TELEGRAM_BOT_USERNAME=
# MINTFLOW_TELEGRAM_WEBHOOK_SECRET=

# Receipt recognition. "fake" reads nothing (every receipt falls back to manual entry) and is
# allowed only in development and test; a real, free provider is chosen in RCPT-07.
# MINTFLOW_RECEIPT_RECOGNIZER=fake
